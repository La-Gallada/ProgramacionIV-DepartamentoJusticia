<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.5.2" />
  </ItemGroup>

  <Target Name="CopyEf6AppConfig" AfterTargets="Build">
    <Copy SourceFiles="App.config" DestinationFiles="$(OutDir)$(AssemblyName).dll.config" SkipUnchangedFiles="true" />
    <Copy SourceFiles="App.config" DestinationFiles="$(OutDir)$(AssemblyName).exe.config" SkipUnchangedFiles="true" />
  </Target>

</Project>
