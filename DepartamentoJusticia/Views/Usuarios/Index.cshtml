@model IEnumerable<Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<h1>Usuarios</h1>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-3 mb-3">
            <label for="nombreCompleto" class="form-label">Nombre</label>
            <input id="nombreCompleto" name="nombreCompleto" type="text" class="form-control" value="@ViewBag.NombreCompleto" />
        </div>
        <div class="col-md-3 mb-3">
            <label for="nombreUsuario" class="form-label">Usuario</label>
            <input id="nombreUsuario" name="nombreUsuario" type="text" class="form-control" value="@ViewBag.NombreUsuario" />
        </div>
        <div class="col-md-3 mb-3">
            <label for="cargo" class="form-label">Cargo</label>
            <select id="cargo" name="cargo" class="form-select">
                <option value="">Todos</option>
                <option value="Administrador" selected="@(ViewBag.Cargo == "Administrador")">Administrador</option>
                <option value="Fiscalizador" selected="@(ViewBag.Cargo == "Fiscalizador")">Fiscalizador</option>
                <option value="Digitador" selected="@(ViewBag.Cargo == "Digitador")">Digitador</option>
            </select>
        </div>
        <div class="col-md-3 mb-3">
            <label for="estado" class="form-label">Estado</label>
            <select id="estado" name="estado" class="form-select">
                <option value="">Todos</option>
                <option value="Activo" selected="@(ViewBag.Estado == "Activo")">Activo</option>
                <option value="Inactivo" selected="@(ViewBag.Estado == "Inactivo")">Inactivo</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Buscar</button>
    <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">Agregar usuario</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nombre completo</th>
            <th>Identificacion</th>
            <th>Cargo</th>
            <th>Fecha de registro</th>
            <th>Estado</th>
            <th>Nombre de usuario</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Usuario usuario in Model)
        {
            <tr>
                <td>@usuario.NombreCompleto</td>
                <td>@usuario.Identificacion</td>
                <td>@usuario.Cargo</td>
                <td>@usuario.FechaRegistro.ToString("dd/MM/yyyy")</td>
                <td>@usuario.Estado</td>
                <td>@usuario.NombreUsuario</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@usuario.Id">Editar</a> |
                    <a asp-action="CambiarContrasenia" asp-route-id="@usuario.Id">Cambiar contrasena</a> |
                    <a asp-action="Delete" asp-route-id="@usuario.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
