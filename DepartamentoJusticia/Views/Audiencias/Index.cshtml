@model BusquedaAudienciaViewModel
@{
    ViewData["Title"] = "Audiencias";
}

<partial name="_EncabezadoModulo" model='new EncabezadoModulo {
    Titulo = "Audiencias",
    Descripcion = "Programacion y seguimiento de las audiencias judiciales.",
    TextoBoton = "Agregar audiencia",
    Controlador = "Audiencias",
    Accion = "Crear" }' />

<form method="get" asp-action="Index">
    <div class="dj-panel">
        <div class="dj-panel-titulo">Busqueda por multiples criterios</div>
        <div class="dj-panel-cuerpo">
            <div class="dj-formulario-rejilla">
                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="NombreTribunal">Tribunal</label>
                    <select class="dj-control" asp-for="NombreTribunal">
                        <option value="">Todos</option>
                        @foreach (var tribunal in Model.Tribunales)
                        {
                            <option value="@tribunal">@tribunal</option>
                        }
                    </select>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="TipoAudiencia">Tipo de audiencia</label>
                    <select class="dj-control" asp-for="TipoAudiencia">
                        <option value="">Todos</option>
                        @foreach (var tipo in AudienciaViewModel.TiposAudiencia)
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="Estado">Estado</label>
                    <select class="dj-control" asp-for="Estado">
                        <option value="">Todos</option>
                        @foreach (var estado in AudienciaViewModel.Estados)
                        {
                            <option value="@estado">@estado</option>
                        }
                    </select>
                </div>
            </div>

            <div class="dj-acciones">
                <button type="submit" class="dj-boton dj-boton-primario">Buscar</button>
                <a asp-action="Index" class="dj-boton dj-boton-secundario">Limpiar filtros</a>
            </div>
        </div>
    </div>
</form>

<div class="dj-panel">
    <div class="dj-panel-titulo">Listado de audiencias</div>

    @if (Model.Resultados.Count == 0)
    {
        <p class="dj-tabla-vacia">No hay audiencias registradas con los criterios indicados.</p>
    }
    else
    {
        <div class="dj-tabla-envoltura">
            <table class="dj-tabla">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Tipo</th>
                        <th>Tribunal</th>
                        <th>Caso judicial</th>
                        <th>Estado</th>
                        <th class="dj-tabla-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var audiencia in Model.Resultados)
                    {
                        <tr>
                            <td>@audiencia.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@audiencia.Hora.ToString(@"hh\:mm")</td>
                            <td>@audiencia.TipoAudiencia</td>
                            <td>@audiencia.NombreTribunal</td>
                            <td>@audiencia.NumeroCaso</td>
                            <td><span class="dj-etiqueta-estado @Etiquetas.ClaseEstado(audiencia.Estado)">@audiencia.Estado</span></td>
                            <td class="dj-tabla-acciones">
                                <a class="dj-boton dj-boton-secundario dj-boton-pequeno" asp-action="Detalles" asp-route-id="@audiencia.Id">Ver</a>
                                <a class="dj-boton dj-boton-secundario dj-boton-pequeno" asp-action="Editar" asp-route-id="@audiencia.Id">Editar</a>
                                <a class="dj-boton dj-boton-peligro dj-boton-pequeno" asp-action="Eliminar" asp-route-id="@audiencia.Id">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="dj-panel-cuerpo">
            <span class="dj-contador">@Model.Resultados.Count audiencia(s) encontrada(s).</span>
        </div>
    }
</div>
