@model List<Audiencia>
@{
    ViewData["Title"] = "Audiencias";
    var tribunales = ViewBag.Tribunales as List<string> ?? new List<string>();
}

<partial name="_EncabezadoModulo" model='new EncabezadoModulo {
    Titulo = "Audiencias",
    Descripcion = "Programación y seguimiento de las audiencias judiciales.",
    TextoBoton = "Agregar audiencia",
    Controlador = "Audiencias",
    Accion = "Create" }' />

<form method="post" asp-action="Index">
    <div class="dj-panel">
        <div class="dj-panel-titulo">Búsqueda por múltiples criterios</div>
        <div class="dj-panel-cuerpo">
            <div class="dj-formulario-rejilla">
                <div class="dj-campo">
                    <label class="dj-etiqueta" for="nombreTribunal">Tribunal</label>
                    <select class="dj-control" id="nombreTribunal" name="nombreTribunal">
                        <option value="">Todos</option>
                        @foreach (var tribunal in tribunales)
                        {
                            <option value="@tribunal">@tribunal</option>
                        }
                    </select>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" for="tipoAudiencia">Tipo de audiencia</label>
                    <select class="dj-control" id="tipoAudiencia" name="tipoAudiencia">
                        <option value="">Todos</option>
                        <option value="Privada">Privada</option>
                        <option value="Pública">Pública</option>
                    </select>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" for="estado">Estado</label>
                    <select class="dj-control" id="estado" name="estado">
                        <option value="">Todos</option>
                        <option value="Programada">Programada</option>
                        <option value="En Desarrollo">En Desarrollo</option>
                        <option value="Suspendida">Suspendida</option>
                        <option value="Celebrada">Celebrada</option>
                    </select>
                </div>
            </div>

            <div class="dj-acciones">
                <button type="submit" class="dj-boton dj-boton-primario">Buscar</button>
                <a asp-action="Index" class="dj-boton dj-boton-secundario">Limpiar filtros</a>
            </div>
        </div>
    </div>
</form>

<div class="dj-panel">
    <div class="dj-panel-titulo">Listado de audiencias</div>

    @if (Model.Count == 0)
    {
        <p class="dj-tabla-vacia">No hay audiencias registradas con los criterios indicados.</p>
    }
    else
    {
        <div class="dj-tabla-envoltura">
            <table class="dj-tabla">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Hora</th>
                        <th>Tipo</th>
                        <th>Tribunal</th>
                        <th>Caso judicial</th>
                        <th>Estado</th>
                        <th class="dj-tabla-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var audiencia in Model)
                    {
                        <tr>
                            <td>@audiencia.Fecha.ToString("dd/MM/yyyy")</td>
                            <td>@audiencia.Hora.ToString(@"hh\:mm")</td>
                            <td>@audiencia.TipoAudiencia</td>
                            <td>@audiencia.NombreTribunal</td>
                            <td>@audiencia.NumeroCaso</td>
                            <td><span class="dj-etiqueta-estado @Etiquetas.ClaseEstado(audiencia.Estado)">@audiencia.Estado</span></td>
                            <td class="dj-tabla-acciones">
                                <a class="dj-boton dj-boton-secundario dj-boton-pequeno" asp-action="Edit" asp-route-id="@audiencia.Id">Editar</a>
                                <a class="dj-boton dj-boton-peligro dj-boton-pequeno" asp-action="Delete" asp-route-id="@audiencia.Id" onclick="return confirm('¿Está seguro de eliminar esta audiencia?');">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="dj-panel-cuerpo">
            <span class="dj-contador">@Model.Count audiencia(s) encontrada(s).</span>
        </div>
    }
</div>