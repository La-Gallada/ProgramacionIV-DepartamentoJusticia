@model Audiencia
@{
    ViewData["Title"] = "Agregar audiencia";
    var tribunales = ViewBag.Tribunales as List<string> ?? new List<string>();
    var casos = ViewBag.CasosJudiciales as List<string> ?? new List<string>();
}

<partial name="_EncabezadoModulo" model='new EncabezadoModulo {
    Titulo = "Agregar audiencia",
    Descripcion = "Complete los datos de la audiencia judicial." }' />

<form method="post" asp-action="Create">
    @Html.AntiForgeryToken()
    <div class="dj-panel">
        <div class="dj-panel-titulo">Datos de la audiencia</div>
        <div class="dj-panel-cuerpo">

            <div asp-validation-summary="ModelOnly" class="dj-resumen-errores"></div>

            <div class="dj-formulario-rejilla">

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="Fecha"></label>
                    <input class="dj-control" asp-for="Fecha" type="date" />
                    <span class="dj-error" asp-validation-for="Fecha"></span>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="Hora"></label>
                    <input class="dj-control" asp-for="Hora" type="time" />
                    <span class="dj-error" asp-validation-for="Hora"></span>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="TipoAudiencia"></label>
                    <select class="dj-control" asp-for="TipoAudiencia">
                        <option value="">-- Seleccione --</option>
                        <option value="Privada">Privada</option>
                        <option value="Pública">Pública</option>
                    </select>
                    <span class="dj-error" asp-validation-for="TipoAudiencia"></span>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="Estado"></label>
                    <select class="dj-control" asp-for="Estado">
                        <option value="">-- Seleccione --</option>
                        <option value="Programada">Programada</option>
                        <option value="En Desarrollo">En Desarrollo</option>
                        <option value="Suspendida">Suspendida</option>
                        <option value="Celebrada">Celebrada</option>
                    </select>
                    <span class="dj-error" asp-validation-for="Estado"></span>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="NombreTribunal"></label>
                    <select class="dj-control" asp-for="NombreTribunal">
                        <option value="">-- Seleccione el tribunal --</option>
                        @foreach (var tribunal in tribunales)
                        {
                            <option value="@tribunal">@tribunal</option>
                        }
                    </select>
                    <span class="dj-error" asp-validation-for="NombreTribunal"></span>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="NumeroCaso"></label>
                    <select class="dj-control" asp-for="NumeroCaso">
                        <option value="">-- Seleccione el caso --</option>
                        @foreach (var caso in casos)
                        {
                            <option value="@caso">@caso</option>
                        }
                    </select>
                    <span class="dj-error" asp-validation-for="NumeroCaso"></span>
                </div>

                <div class="dj-campo dj-campo-ancho">
                    <label class="dj-etiqueta" asp-for="Observaciones"></label>
                    <textarea class="dj-control" asp-for="Observaciones" placeholder="Información adicional de la audiencia"></textarea>
                    <span class="dj-error" asp-validation-for="Observaciones"></span>
                </div>

            </div>

            <div class="dj-acciones">
                <button type="submit" class="dj-boton dj-boton-primario">Guardar</button>
                <a asp-action="Index" class="dj-boton dj-boton-secundario">Cancelar</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}