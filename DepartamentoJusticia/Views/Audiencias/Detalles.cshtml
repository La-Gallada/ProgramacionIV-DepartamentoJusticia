@model Audiencia
@{
    ViewData["Title"] = "Detalle de la audiencia";
}

<partial name="_EncabezadoModulo" model='new EncabezadoModulo {
    Titulo = "Detalle de la audiencia",
    Descripcion = "Informacion completa de la audiencia judicial." }' />

<div class="dj-panel">
    <div class="dj-panel-titulo">Informacion registrada</div>
    <div class="dj-panel-cuerpo">
        <dl class="dj-detalle">
            <div class="dj-detalle-item"><dt>Fecha</dt><dd>@Model.Fecha.ToString("dd/MM/yyyy")</dd></div>
            <div class="dj-detalle-item"><dt>Hora</dt><dd>@Model.Hora.ToString(@"hh\:mm")</dd></div>
            <div class="dj-detalle-item"><dt>Tipo de audiencia</dt><dd>@Model.TipoAudiencia</dd></div>
            <div class="dj-detalle-item"><dt>Tribunal asignado</dt><dd>@Model.NombreTribunal</dd></div>
            <div class="dj-detalle-item"><dt>Caso judicial vinculado</dt><dd>@Model.NumeroCaso</dd></div>
            <div class="dj-detalle-item"><dt>Estado</dt><dd><span class="dj-etiqueta-estado @Etiquetas.ClaseEstado(Model.Estado)">@Model.Estado</span></dd></div>
            <div class="dj-detalle-item"><dt>Observaciones</dt><dd>@(string.IsNullOrWhiteSpace(Model.Observaciones) ? "Sin observaciones." : Model.Observaciones)</dd></div>
        </dl>

        <div class="dj-acciones">
            <a asp-action="Editar" asp-route-id="@Model.Id" class="dj-boton dj-boton-primario">Actualizar</a>
            <a asp-action="Index" class="dj-boton dj-boton-secundario">Volver al listado</a>
        </div>
    </div>
</div>
