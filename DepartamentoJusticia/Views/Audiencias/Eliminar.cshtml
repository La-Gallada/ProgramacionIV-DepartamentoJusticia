@model Audiencia
@{
    ViewData["Title"] = "Eliminar audiencia";
}

<partial name="_EncabezadoModulo" model='new EncabezadoModulo {
    Titulo = "Eliminar audiencia",
    Descripcion = "Esta acción no se puede deshacer." }' />

<div class="dj-mensaje dj-mensaje-aviso">
    Confirme que desea eliminar la audiencia del <strong>@Model.Fecha.ToString("dd/MM/yyyy")</strong> a las <strong>@Model.Hora.ToString(@"hh\:mm")</strong>.
</div>

<div class="dj-panel">
    <div class="dj-panel-titulo">Registro por eliminar</div>
    <div class="dj-panel-cuerpo">
        <dl class="dj-detalle">
            <div class="dj-detalle-item"><dt>Tribunal</dt><dd>@Model.NombreTribunal</dd></div>
            <div class="dj-detalle-item"><dt>Caso judicial</dt><dd>@Model.NumeroCaso</dd></div>
            <div class="dj-detalle-item"><dt>Tipo</dt><dd>@Model.TipoAudiencia</dd></div>
            <div class="dj-detalle-item"><dt>Estado</dt><dd><span class="dj-etiqueta-estado @Etiquetas.ClaseEstado(Model.Estado)">@Model.Estado</span></dd></div>
        </dl>

        <form method="post" asp-action="Eliminar">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="dj-acciones">
                <button type="submit" class="dj-boton dj-boton-peligro">Si, eliminar</button>
                <a asp-action="Index" class="dj-boton dj-boton-secundario">Cancelar</a>
            </div>
        </form>
    </div>
</div>
