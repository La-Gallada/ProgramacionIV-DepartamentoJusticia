@model AudienciaViewModel

<input type="hidden" asp-for="Audiencia.Id" />

<div asp-validation-summary="ModelOnly" class="dj-resumen-errores"></div>

<div class="dj-formulario-rejilla">
    <div class="dj-campo">
        <label class="dj-etiqueta" asp-for="Audiencia.Fecha"></label>
        <input class="dj-control" asp-for="Audiencia.Fecha" type="date" />
        <span class="dj-error" asp-validation-for="Audiencia.Fecha"></span>
    </div>

    <div class="dj-campo">
        <label class="dj-etiqueta" asp-for="Audiencia.Hora"></label>
        <input class="dj-control" asp-for="Audiencia.Hora" type="time" />
        <span class="dj-error" asp-validation-for="Audiencia.Hora"></span>
    </div>

    <div class="dj-campo">
        <label class="dj-etiqueta" asp-for="Audiencia.TipoAudiencia"></label>
        <select class="dj-control" asp-for="Audiencia.TipoAudiencia">
            <option value="">-- Seleccione --</option>
            @foreach (var tipo in AudienciaViewModel.TiposAudiencia)
            {
                <option value="@tipo">@tipo</option>
            }
        </select>
        <span class="dj-error" asp-validation-for="Audiencia.TipoAudiencia"></span>
    </div>

    <div class="dj-campo">
        <label class="dj-etiqueta" asp-for="Audiencia.Estado"></label>
        <select class="dj-control" asp-for="Audiencia.Estado">
            <option value="">-- Seleccione --</option>
            @foreach (var estado in AudienciaViewModel.Estados)
            {
                <option value="@estado">@estado</option>
            }
        </select>
        <span class="dj-error" asp-validation-for="Audiencia.Estado"></span>
    </div>

    <div class="dj-campo">
        <label class="dj-etiqueta" asp-for="Audiencia.NombreTribunal"></label>
        @if (Model.Tribunales.Count == 0)
        {
            <select class="dj-control" disabled><option>No hay tribunales registrados</option></select>
            <span class="dj-error">Debe existir al menos un tribunal antes de registrar audiencias.</span>
        }
        else
        {
            <select class="dj-control" asp-for="Audiencia.NombreTribunal">
                <option value="">-- Seleccione el tribunal --</option>
                @foreach (var tribunal in Model.Tribunales)
                {
                    <option value="@tribunal">@tribunal</option>
                }
            </select>
        }
        <span class="dj-error" asp-validation-for="Audiencia.NombreTribunal"></span>
    </div>

    <div class="dj-campo">
        <label class="dj-etiqueta" asp-for="Audiencia.NumeroCaso"></label>
        @if (Model.CasosJudiciales.Count == 0)
        {
            <select class="dj-control" disabled><option>No hay casos judiciales registrados</option></select>
            <span class="dj-error">Debe existir al menos un caso judicial antes de registrar audiencias.</span>
        }
        else
        {
            <select class="dj-control" asp-for="Audiencia.NumeroCaso">
                <option value="">-- Seleccione el caso --</option>
                @foreach (var caso in Model.CasosJudiciales)
                {
                    <option value="@caso">@caso</option>
                }
            </select>
        }
        <span class="dj-error" asp-validation-for="Audiencia.NumeroCaso"></span>
    </div>

    <div class="dj-campo dj-campo-ancho">
        <label class="dj-etiqueta" asp-for="Audiencia.Observaciones"></label>
        <textarea class="dj-control" asp-for="Audiencia.Observaciones" placeholder="Informacion adicional de la audiencia"></textarea>
        <span class="dj-error" asp-validation-for="Audiencia.Observaciones"></span>
    </div>
</div>
