<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Departamento de Justicia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DepartamentoJusticia.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Inicio" asp-action="Index">Departamento de Justicia</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Abrir navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Inicio" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                       <a class="nav-link text-dark" asp-area="" asp-controller="Agentes" asp-action="Index">Agentes Federales</a>
                       </li>
                       <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Casos" asp-action="Index">Casos Judiciales</a>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link text-muted">Sospechosos</span>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link text-muted">Evidencias</span>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link text-muted">Operativos</span>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link text-muted">Tribunales</span>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link text-muted">Audiencias</span>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link text-muted">Usuarios</span>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link text-muted">Bitácora</span>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link text-muted">Acerca de</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Login" asp-action="Index">Cerrar Sesión</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Departamento de Justicia
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
