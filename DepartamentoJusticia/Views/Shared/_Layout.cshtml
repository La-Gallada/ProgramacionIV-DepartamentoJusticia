@*
    Layout principal del sistema.
    EQUIPO: cuando terminen el controlador de su modulo, busquen su <li> en el
    menu y reemplacen el <span class="dj-menu-enlace pendiente"> por:
        <a class="dj-menu-enlace @Activo("SuControlador")" asp-controller="SuControlador" asp-action="Index">Su Modulo</a>
    No agreguen CSS nuevo: usen las clases de wwwroot/css/departamento.css.
*@
@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Activo(string nombre) => controladorActual.Equals(nombre, StringComparison.OrdinalIgnoreCase) ? "activo" : "";
    var usuarioSesion = Context.Session.GetString("NombreCompleto");
    var cargoSesion = Context.Session.GetString("Cargo");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Departamento de Justicia</title>
    <link rel="stylesheet" href="~/css/departamento.css" asp-append-version="true" />
</head>
<body>
    <div class="dj-contenedor">

        <nav class="dj-menu">
            <div class="dj-menu-marca">
                <span class="dj-menu-marca-escudo">DJ</span>
                <a class="dj-menu-marca-titulo" asp-controller="Inicio" asp-action="Index">Departamento de Justicia</a>
                <span class="dj-menu-marca-sub">Sistema de Gestion</span>
            </div>

            <ul class="dj-menu-lista">
                <li><a class="dj-menu-enlace @Activo("Inicio")" asp-controller="Inicio" asp-action="Index">Inicio</a></li>

                <li><a class="dj-menu-enlace @Activo("Agentes")" asp-controller="Agentes" asp-action="Index">Agentes Federales</a></li>

                <li><a class="dj-menu-enlace @Activo("Casos")" asp-controller="Casos" asp-action="Index">Casos Judiciales</a></li>

                <li><a class="dj-menu-enlace @Activo("Sospechosos")" asp-controller="Sospechosos" asp-action="Index">Sospechosos</a></li>

                <li><a class="dj-menu-enlace @Activo("Evidencia")" asp-controller="Evidencia" asp-action="Index">Evidencias</a></li>

                <li><a class="dj-menu-enlace @Activo("Operativos")" asp-controller="Operativos" asp-action="Index">Operativos</a></li>

                <li><a class="dj-menu-enlace @Activo("Tribunal")" asp-controller="Tribunal" asp-action="Index">Tribunales</a></li>

                <li><a class="dj-menu-enlace @Activo("Audiencias")" asp-controller="Audiencias" asp-action="Index">Audiencias</a></li>

                <li><a class="dj-menu-enlace @Activo("Usuarios")" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>

                <li><a class="dj-menu-enlace @Activo("Bitacora")" asp-controller="Bitacora" asp-action="Index">Bitacora</a></li>

                <hr class="dj-menu-separador" />

                <li><a class="dj-menu-enlace @Activo("AcercaDe")" asp-controller="AcercaDe" asp-action="Index">Acerca de</a></li>
                <li><a class="dj-menu-enlace" asp-controller="Login" asp-action="CerrarSesion">Cerrar Sesion</a></li>
            </ul>

            <div class="dj-menu-pie">
                Version 1.0 &middot; 2026
            </div>
        </nav>

        <div class="dj-principal">
            <div class="dj-barra-superior">
                <h2 class="dj-barra-titulo">@ViewData["Title"]</h2>
                <div class="dj-barra-usuario">
                    @if (!string.IsNullOrEmpty(usuarioSesion))
                    {
                        <span>Sesion iniciada por <strong>@usuarioSesion</strong> (@cargoSesion)</span>
                    }
                </div>
            </div>

            <main class="dj-cuerpo" role="main">
                <partial name="_MensajeAlerta" />
                @RenderBody()
            </main>

            <footer class="dj-pie">
                &copy; 2026 Departamento de Justicia &middot; Proyecto Final Programacion IV
            </footer>
        </div>

    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>