@{
    ViewData["Title"] = "Inicio de sesion";
    Layout = "_LayoutAcceso";
}
<div class="dj-login-caja">
    <div class="dj-login-encabezado">
        <span class="dj-login-escudo">DJ</span>
        <h1>Departamento de Justicia</h1>
        <p>Acceso exclusivo para personal autorizado</p>
    </div>
    <div asp-validation-summary="All" class="dj-mensaje dj-mensaje-error"></div>
    @if (TempData["Error"] != null)
    {
        <div class="dj-mensaje dj-mensaje-error">@TempData["Error"]</div>
    }
    <form method="post" asp-action="Index">
        <div class="dj-campo">
            <label class="dj-etiqueta" for="nombreUsuario">Nombre de usuario</label>
            <input class="dj-control" id="nombreUsuario" name="nombreUsuario" autocomplete="username" required />
        </div>
        <div class="dj-campo">
            <label class="dj-etiqueta" for="contrasenia">Contrasena</label>
            <input class="dj-control" id="contrasenia" name="contrasenia" type="password" autocomplete="current-password" required />
        </div>
        <button type="submit" class="dj-boton dj-boton-primario">Ingresar</button>
    </form>
</div>