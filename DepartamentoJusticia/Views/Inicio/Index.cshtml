@{
    ViewData["Title"] = "Inicio";
}

<div class="dj-portada">
    @* Imagen institucional (requisito del enunciado).
       Se puede sustituir portada.svg por una fotografia real en wwwroot/img/. *@
    <img src="~/img/portada.svg" alt="Departamento de Justicia" />
    <div class="dj-portada-texto">
        <h1>Departamento de Justicia</h1>
        <p>
            Sistema institucional para la administracion de investigaciones criminales,
            operativos, evidencias y procesos judiciales.
        </p>
    </div>
</div>

<div class="dj-atajos">
    <a class="dj-atajo" asp-controller="Sospechosos" asp-action="Index">
        <strong>Sospechosos</strong>
        <span>Personas vinculadas a los casos judiciales.</span>
    </a>

    <a class="dj-atajo" asp-controller="Audiencias" asp-action="Index">
        <strong>Audiencias</strong>
        <span>Programacion y seguimiento de las audiencias judiciales.</span>
    </a>
</div>
