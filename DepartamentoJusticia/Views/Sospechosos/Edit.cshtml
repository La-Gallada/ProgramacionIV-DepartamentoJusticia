@model Sospechoso
@{
    ViewData["Title"] = "Editar sospechoso";
    var casos = ViewBag.CasosJudiciales as List<string> ?? new List<string>();
}

<partial name="_EncabezadoModulo" model='new EncabezadoModulo {
    Titulo = "Editar sospechoso",
    Descripcion = "Modifique los datos de la persona sospechosa." }' />

<form method="post" asp-action="Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="dj-panel">
        <div class="dj-panel-titulo">Datos del sospechoso</div>
        <div class="dj-panel-cuerpo">

            <div asp-validation-summary="ModelOnly" class="dj-resumen-errores"></div>

            <div class="dj-formulario-rejilla">

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="Identificacion"></label>
                    <input class="dj-control" asp-for="Identificacion" />
                    <span class="dj-error" asp-validation-for="Identificacion"></span>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="NombreCompleto"></label>
                    <input class="dj-control" asp-for="NombreCompleto" />
                    <span class="dj-error" asp-validation-for="NombreCompleto"></span>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="Nacionalidad"></label>
                    <input class="dj-control" asp-for="Nacionalidad" />
                    <span class="dj-error" asp-validation-for="Nacionalidad"></span>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="FechaNacimiento"></label>
                    <input class="dj-control" asp-for="FechaNacimiento" type="date" />
                    <span class="dj-error" asp-validation-for="FechaNacimiento"></span>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="NivelPeligrosidad"></label>
                    <input class="dj-control" asp-for="NivelPeligrosidad" type="number" min="1" max="100" />
                    <span class="dj-ayuda">Escala del 1 al 100. El nivel de riesgo se calcula automáticamente.</span>
                    <span class="dj-error" asp-validation-for="NivelPeligrosidad"></span>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" asp-for="EstadoLegal"></label>
                    <select class="dj-control" asp-for="EstadoLegal">
                        <option value="">-- Seleccione --</option>
                        <option value="Sin Cargos">Sin Cargos</option>
                        <option value="Investigado">Investigado</option>
                        <option value="Detenido">Detenido</option>
                        <option value="Procesado">Procesado</option>
                        <option value="Sentenciado">Sentenciado</option>
                    </select>
                    <span class="dj-error" asp-validation-for="EstadoLegal"></span>
                </div>

                <div class="dj-campo dj-campo-ancho">
                    <label class="dj-etiqueta" asp-for="NumeroCaso"></label>
                    <select class="dj-control" asp-for="NumeroCaso">
                        <option value="">-- Seleccione el caso --</option>
                        @foreach (var caso in casos)
                        {
                            <option value="@caso">@caso</option>
                        }
                    </select>
                    <span class="dj-error" asp-validation-for="NumeroCaso"></span>
                </div>

            </div>

            <div class="dj-acciones">
                <button type="submit" class="dj-boton dj-boton-primario">Guardar cambios</button>
                <a asp-action="Index" class="dj-boton dj-boton-secundario">Cancelar</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}