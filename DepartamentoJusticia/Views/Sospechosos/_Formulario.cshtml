@* Campos compartidos entre Crear y Editar. Evita duplicar el formulario. *@
@model SospechosoViewModel

<input type="hidden" asp-for="Sospechoso.Id" />

<div asp-validation-summary="ModelOnly" class="dj-resumen-errores"></div>

<div class="dj-formulario-rejilla">

    <div class="dj-campo">
        <label class="dj-etiqueta" asp-for="Sospechoso.Identificacion"></label>
        <input class="dj-control" asp-for="Sospechoso.Identificacion" />
        <span class="dj-error" asp-validation-for="Sospechoso.Identificacion"></span>
    </div>

    <div class="dj-campo">
        <label class="dj-etiqueta" asp-for="Sospechoso.NombreCompleto"></label>
        <input class="dj-control" asp-for="Sospechoso.NombreCompleto" />
        <span class="dj-error" asp-validation-for="Sospechoso.NombreCompleto"></span>
    </div>

    <div class="dj-campo">
        <label class="dj-etiqueta" asp-for="Sospechoso.Nacionalidad"></label>
        <input class="dj-control" asp-for="Sospechoso.Nacionalidad" />
        <span class="dj-error" asp-validation-for="Sospechoso.Nacionalidad"></span>
    </div>

    <div class="dj-campo">
        <label class="dj-etiqueta" asp-for="Sospechoso.FechaNacimiento"></label>
        <input class="dj-control" asp-for="Sospechoso.FechaNacimiento" type="date" />
        <span class="dj-error" asp-validation-for="Sospechoso.FechaNacimiento"></span>
    </div>

    <div class="dj-campo">
        <label class="dj-etiqueta" asp-for="Sospechoso.NivelPeligrosidad"></label>
        <input class="dj-control" asp-for="Sospechoso.NivelPeligrosidad" type="number" min="1" max="100" />
        <span class="dj-ayuda">Escala del 1 al 100. El nivel de riesgo se calcula automáticamente.</span>
        <span class="dj-error" asp-validation-for="Sospechoso.NivelPeligrosidad"></span>
    </div>

    <div class="dj-campo">
        <label class="dj-etiqueta" asp-for="Sospechoso.EstadoLegal"></label>
        <select class="dj-control" asp-for="Sospechoso.EstadoLegal">
            <option value="">-- Seleccione --</option>
            @foreach (var estado in SospechosoViewModel.EstadosLegales)
            {
                <option value="@estado">@estado</option>
            }
        </select>
        <span class="dj-error" asp-validation-for="Sospechoso.EstadoLegal"></span>
    </div>

    <div class="dj-campo dj-campo-ancho">
        <label class="dj-etiqueta" asp-for="Sospechoso.NumeroCaso"></label>
        @if (Model.CasosJudiciales.Count == 0)
        {
            <select class="dj-control" disabled>
                <option>No hay casos judiciales registrados</option>
            </select>
            <span class="dj-error">Debe existir al menos un caso judicial antes de registrar sospechosos.</span>
        }
        else
        {
            <select class="dj-control" asp-for="Sospechoso.NumeroCaso">
                <option value="">-- Seleccione el caso --</option>
                @foreach (var caso in Model.CasosJudiciales)
                {
                    <option value="@caso">@caso</option>
                }
            </select>
        }
        <span class="dj-error" asp-validation-for="Sospechoso.NumeroCaso"></span>
    </div>

</div>
