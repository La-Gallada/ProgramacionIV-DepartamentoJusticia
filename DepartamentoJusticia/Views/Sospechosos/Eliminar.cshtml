@model Sospechoso
@{
    ViewData["Title"] = "Eliminar sospechoso";
}

<partial name="_EncabezadoModulo" model='new EncabezadoModulo {
    Titulo = "Eliminar sospechoso",
    Descripcion = "Esta accion no se puede deshacer." }' />

<div class="dj-mensaje dj-mensaje-aviso">
    Confirme que desea eliminar de forma permanente el registro de
    <strong>@Model.NombreCompleto</strong>.
</div>

<div class="dj-panel">
    <div class="dj-panel-titulo">Registro por eliminar</div>
    <div class="dj-panel-cuerpo">
        <dl class="dj-detalle">
            <div class="dj-detalle-item">
                <dt>Identificacion</dt>
                <dd>@Model.Identificacion</dd>
            </div>
            <div class="dj-detalle-item">
                <dt>Nombre completo</dt>
                <dd>@Model.NombreCompleto</dd>
            </div>
            <div class="dj-detalle-item">
                <dt>Estado legal</dt>
                <dd>
                    <span class="dj-etiqueta-estado @Etiquetas.ClaseEstado(Model.EstadoLegal)">@Model.EstadoLegal</span>
                </dd>
            </div>
            <div class="dj-detalle-item">
                <dt>Nivel de riesgo</dt>
                <dd>
                    <span class="dj-etiqueta-estado @Etiquetas.ClaseRiesgo(Model.NivelRiesgo)">@Model.NivelRiesgo</span>
                </dd>
            </div>
            <div class="dj-detalle-item">
                <dt>Caso judicial vinculado</dt>
                <dd>@Model.NumeroCaso</dd>
            </div>
        </dl>

        <form method="post" asp-action="Delete">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="dj-acciones">
                <button type="submit" class="dj-boton dj-boton-peligro">Si, eliminar</button>
                <a asp-action="Index" class="dj-boton dj-boton-secundario">Cancelar</a>
            </div>
        </form>
    </div>
</div>
