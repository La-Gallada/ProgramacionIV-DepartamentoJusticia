@model SospechosoViewModel
@{
    ViewData["Title"] = "Agregar sospechoso";
}

<partial name="_EncabezadoModulo" model='new EncabezadoModulo {
    Titulo = "Agregar sospechoso",
    Descripcion = "Complete los datos de la persona sospechosa." }' />

<form method="post" asp-action="Create">
    <div class="dj-panel">
        <div class="dj-panel-titulo">Datos del sospechoso</div>
        <div class="dj-panel-cuerpo">
            <partial name="_Formulario" model="Model" />

            <div class="dj-acciones">
                <button type="submit" class="dj-boton dj-boton-primario">Guardar</button>
                <a asp-action="Index" class="dj-boton dj-boton-secundario">Cancelar</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
