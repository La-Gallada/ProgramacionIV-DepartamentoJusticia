@model List<Sospechoso>
@{
    ViewData["Title"] = "Sospechosos";
}

<partial name="_EncabezadoModulo" model='new EncabezadoModulo {
    Titulo = "Sospechosos",
    Descripcion = "Personas vinculadas a los casos judiciales en investigación.",
    TextoBoton = "Agregar sospechoso",
    Controlador = "Sospechosos",
    Accion = "Create" }' />

<form method="post" asp-action="Index">
    <div class="dj-panel">
        <div class="dj-panel-titulo">Búsqueda por múltiples criterios</div>
        <div class="dj-panel-cuerpo">
            <div class="dj-formulario-rejilla">

                <div class="dj-campo">
                    <label class="dj-etiqueta" for="nombreCompleto">Nombre</label>
                    <input class="dj-control" id="nombreCompleto" name="nombreCompleto" placeholder="Nombre completo o parte de el" />
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" for="estadoLegal">Estado legal</label>
                    <select class="dj-control" id="estadoLegal" name="estadoLegal">
                        <option value="">Todos</option>
                        <option value="Sin Cargos">Sin Cargos</option>
                        <option value="Investigado">Investigado</option>
                        <option value="Detenido">Detenido</option>
                        <option value="Procesado">Procesado</option>
                        <option value="Sentenciado">Sentenciado</option>
                    </select>
                </div>

                <div class="dj-campo">
                    <label class="dj-etiqueta" for="nivelRiesgo">Nivel de riesgo</label>
                    <select class="dj-control" id="nivelRiesgo" name="nivelRiesgo">
                        <option value="">Todos</option>
                        <option value="Riesgo Bajo">Riesgo Bajo</option>
                        <option value="Riesgo Moderado">Riesgo Moderado</option>
                        <option value="Riesgo Alto">Riesgo Alto</option>
                        <option value="Riesgo Crítico">Riesgo Crítico</option>
                    </select>
                </div>

            </div>

            <div class="dj-acciones">
                <button type="submit" class="dj-boton dj-boton-primario">Buscar</button>
                <a asp-action="Index" class="dj-boton dj-boton-secundario">Limpiar filtros</a>
            </div>
        </div>
    </div>
</form>

<div class="dj-panel">
    <div class="dj-panel-titulo">Listado de sospechosos</div>

    @if (Model.Count == 0)
    {
        <p class="dj-tabla-vacia">No hay sospechosos registrados con los criterios indicados.</p>
    }
    else
    {
        <div class="dj-tabla-envoltura">
            <table class="dj-tabla">
                <thead>
                    <tr>
                        <th>Identificación</th>
                        <th>Nombre completo</th>
                        <th>Nacionalidad</th>
                        <th class="dj-tabla-numero">Peligrosidad</th>
                        <th>Nivel de riesgo</th>
                        <th>Estado legal</th>
                        <th>Caso</th>
                        <th class="dj-tabla-acciones">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sospechoso in Model)
                    {
                        <tr>
                            <td>@sospechoso.Identificacion</td>
                            <td>@sospechoso.NombreCompleto</td>
                            <td>@sospechoso.Nacionalidad</td>
                            <td class="dj-tabla-numero">@sospechoso.NivelPeligrosidad</td>
                            <td>
                                <span class="dj-etiqueta-estado @Etiquetas.ClaseRiesgo(sospechoso.NivelRiesgo)">
                                    @sospechoso.NivelRiesgo
                                </span>
                            </td>
                            <td>
                                <span class="dj-etiqueta-estado @Etiquetas.ClaseEstado(sospechoso.EstadoLegal)">
                                    @sospechoso.EstadoLegal
                                </span>
                            </td>
                            <td>@sospechoso.NumeroCaso</td>
                            <td class="dj-tabla-acciones">
                                <a class="dj-boton dj-boton-secundario dj-boton-pequeno" asp-action="Edit" asp-route-id="@sospechoso.Id">Editar</a>
                                <a class="dj-boton dj-boton-peligro dj-boton-pequeno" asp-action="Delete" asp-route-id="@sospechoso.Id" onclick="return confirm('¿Está seguro de eliminar este sospechoso?');">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="dj-panel-cuerpo">
            <span class="dj-contador">@Model.Count sospechoso(s) encontrado(s).</span>
        </div>
    }
</div>