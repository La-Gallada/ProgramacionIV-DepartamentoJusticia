@model Tribunal

@{
    ViewData["Title"] = "Eliminar tribunal";
}

<h1>Eliminar tribunal</h1>

<p>Confirme si desea eliminar el siguiente tribunal.</p>

<dl class="row">
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>

    <dt class="col-sm-3">Ciudad</dt>
    <dd class="col-sm-9">@Model.Ciudad</dd>

    <dt class="col-sm-3">Juez asignado</dt>
    <dd class="col-sm-9">@Model.JuezAsignado</dd>

    <dt class="col-sm-3">Cantidad de salas</dt>
    <dd class="col-sm-9">@Model.CantidadSalas</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <input name="confirmar" type="hidden" value="si" />

    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
