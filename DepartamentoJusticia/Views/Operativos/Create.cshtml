@model DepartamentoJusticia.Models.Operativo

<h1>Agregar Operativo</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        @{
            var agentes = ViewBag.Agentes;
            var casos = ViewBag.Casos;
        }
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="NombreOperativo" class="control-label"></label>
                <input asp-for="NombreOperativo" class="form-control" />
                <span asp-validation-for="NombreOperativo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FechaEjecucion" class="control-label"></label>
                <input asp-for="FechaEjecucion" type="date" class="form-control" />
                <span asp-validation-for="FechaEjecucion" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Ciudad" class="control-label"></label>
                <input asp-for="Ciudad" class="form-control" />
                <span asp-validation-for="Ciudad" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TipoOperativo" class="control-label"></label>
                <select asp-for="TipoOperativo" class="form-control">
                    <option value="">Seleccione un tipo de operativo</option>
                    <option value="Intervención y Captura">Intervención y Captura</option>
                    <option value="Inteligencia y Vigilancia">Inteligencia y Vigilancia</option>
                    <option value="Contención y Disuasión">Contención y Disuasión</option>
                    <option value="Especiales y de Emergencia">Especiales y de Emergencia</option>
                </select>
                <span asp-validation-for="TipoOperativo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NombreAgente1" class="control-label"></label>
                <select asp-for="NombreAgente1" class="form-control">
                    <option value="">Seleccione un agente</option>
                    @foreach (var agente in agentes)
                    {
                        <option value="@agente.NombreCompleto">@agente.NombreCompleto</option>
                    }
                </select>
                <span asp-validation-for="NombreAgente1" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NombreAgente2" class="control-label"></label>
                <select asp-for="NombreAgente2" class="form-control">
                    <option value="">Seleccione un agente</option>
                    @foreach (var agente in agentes)
                    {
                        <option value="@agente.NombreCompleto">@agente.NombreCompleto</option>
                    }
                </select>
                <span asp-validation-for="NombreAgente2" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NombreAgente3" class="control-label"></label>
                <select asp-for="NombreAgente3" class="form-control">
                    <option value="">Seleccione un agente</option>
                    @foreach (var agente in agentes)
                    {
                        <option value="@agente.NombreCompleto">@agente.NombreCompleto</option>
                    }
                </select>
                <span asp-validation-for="NombreAgente3" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Resultado" class="control-label"></label>
                <select asp-for="Resultado" class="form-control">
                    <option value="">Seleccione un resultado</option>
                    <option value="Efectivo">Efectivo</option>
                    <option value="No efectivo">No efectivo</option>
                </select>
                <span asp-validation-for="Resultado" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumeroCaso" class="control-label"></label>
                <select asp-for="NumeroCaso" class="form-control">
                    <option value="">Seleccione un caso</option>
                    @foreach (var caso in casos)
                    {
                        <option value="@caso.NumeroCaso">@caso.NumeroCaso</option>
                    }
                </select>
                <span asp-validation-for="NumeroCaso" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Agregar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>