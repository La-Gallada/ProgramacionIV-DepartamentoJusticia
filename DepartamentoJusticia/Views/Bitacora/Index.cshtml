@model IEnumerable<Bitacora>

@{
    ViewData["Title"] = "Bitacora";
}

<h1>Bitacora</h1>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="nombreUsuario" class="form-label">Usuario</label>
            <input id="nombreUsuario" name="nombreUsuario" type="text" class="form-control" value="@ViewBag.NombreUsuario" />
        </div>
        <div class="col-md-6 mb-3">
            <label for="resultado" class="form-label">Resultado</label>
            <select id="resultado" name="resultado" class="form-select">
                <option value="">Todos</option>
                <option value="Exitoso" selected="@(ViewBag.Resultado == "Exitoso")">Exitoso</option>
                <option value="Fallido" selected="@(ViewBag.Resultado == "Fallido")">Fallido</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Buscar</button>
    <a asp-action="Index" class="btn btn-secondary">Limpiar filtros</a>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Hora</th>
            <th>Nombre de usuario</th>
            <th>Resultado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Bitacora bitacora in Model)
        {
            <tr>
                <td>@bitacora.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@bitacora.Hora.ToString(@"hh\:mm\:ss")</td>
                <td>@bitacora.NombreUsuario</td>
                <td>@bitacora.Resultado</td>
            </tr>
        }
    </tbody>
</table>
